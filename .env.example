# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
BASE_URL=http://localhost:8080

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=goshorty
DB_PASSWORD=your_password_here
DB_NAME=goshorty
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# 会话配置
SESSION_SECRET=change_this_to_a_random_secret_key_in_production
SESSION_MAX_AGE=86400

# 日志配置
LOG_LEVEL=info
LOG_FORMAT=json

# GeoIP配置
GEOIP_DB_PATH=./data/GeoLite2-City.mmdb

# 插件配置
DEFAULT_EXPIRY_DAYS=7
